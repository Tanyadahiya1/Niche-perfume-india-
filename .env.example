# Copy this file to .env.local and fill in the values (see README.md, step 3).
# The site works WITHOUT these (demo mode: read-only demo data, WhatsApp ordering still works).

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SECRET. Server only. Never put NEXT_PUBLIC_ in front of it. Needed to save orders/enquiries.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Your public website address (used for metadata). Use http://localhost:3000 locally.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
